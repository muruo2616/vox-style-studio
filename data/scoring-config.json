      "70-89": "中等占比、有提价或渗透率逻辑",
      "50-69": "大盘蓝筹、弹性一般",
      "below50": "已充分定价"
    },
    "quality": {
      "90-100": "龙头地位+财务稳健+客户多元",
      "70-89": "细分龙头或高 ROE",
      "50-69": "成长型、盈利波动",
      "below50": "高估值+订单未兑现"
    }
  },
